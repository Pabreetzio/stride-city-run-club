---
import BaseHead from '../components/BaseHead.astro';
import EventCard from '../components/EventCard.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { getPastEvents, getUpcomingEvents } from '../lib/events';

const upcoming = await getUpcomingEvents();
const past = await getPastEvents();

const pageTitle = `Events | ${SITE_TITLE}`;
const pageDescription = 'Upcoming Stride City Run Club races, meetups, and team outings.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />

		<main>
			<section class="events-hero">
				<div class="container">
					<p class="eyebrow">Events</p>
					<h1>Run with Stride City</h1>
					<p class="lede">
						From weekly miles to race-day meetups, this is where we share the events Stride City Run Club is showing up for together.
					</p>
				</div>
			</section>

			<section class="events-list">
				<div class="container">
					<h2>Upcoming</h2>
					{upcoming.length > 0 ? (
						<div class="event-grid">
							{upcoming.map((event) => (
								<EventCard event={event} />
							))}
						</div>
					) : (
						<p class="empty">No races on the calendar right now — check back soon, or come out for a Wednesday night run.</p>
					)}

					{past.length > 0 && (
						<p class="archive-link">
							Looking for a race we've already run?
							<a href="/events/archive">Browse past events &rarr;</a>
						</p>
					)}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.events-hero {
		padding: 5em 1.5em 4em;
		background: linear-gradient(135deg, rgba(0, 0, 0, 0.92), rgba(0, 0, 0, 0.72));
		color: #fff;
	}
	.events-hero h1 {
		margin: 0 0 0.35em;
		font-size: clamp(2.4rem, 6vw, 4rem);
		line-height: 1;
		color: #fff;
	}
	.eyebrow {
		margin: 0 0 0.5em;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.lede {
		max-width: 680px;
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.82);
	}

	.events-list {
		padding: 4em 1.5em;
		background: #fff;
	}
	.events-list h2 {
		font-size: 1.75rem;
		margin-bottom: 1em;
	}

	.event-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5em;
	}

	.empty {
		font-size: 1.05rem;
		color: rgb(var(--gray-dark));
	}

	.archive-link {
		margin: 2.5em 0 0;
		font-size: 1rem;
		color: rgb(var(--gray-dark));
	}
	.archive-link a {
		margin-left: 0.4em;
		font-weight: 700;
		color: var(--accent-dark);
		text-decoration: none;
	}
	.archive-link a:hover {
		text-decoration: underline;
	}
</style>
