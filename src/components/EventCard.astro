---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = {
	event: CollectionEntry<'events'>;
	past?: boolean;
};

const { event, past = false } = Astro.props;
const { title, description, dateLabel, location, image, imageAlt } = event.data;
const href = `/events/${event.id}`;
---

<article class:list={['event-card', { past }]}>
	<a href={href} class="event-card-link" aria-label={title}>
		{image && (
			<div class="event-card-media">
				<Image src={image} alt={imageAlt ?? title} width={640} />
			</div>
		)}
		<div class="event-card-body">
			<p class="event-card-kicker">{past ? 'Past Event' : 'Upcoming Race'}</p>
			<h3>{title}</h3>
			<p class="event-card-meta">
				{dateLabel && <span>{dateLabel}</span>}
				{location && <span>{location}</span>}
			</p>
			<p class="event-card-desc">{description}</p>
			<span class="event-card-cta">{past ? 'View recap' : 'View race details'} &rarr;</span>
		</div>
	</a>
</article>

<style>
	.event-card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 16px;
		overflow: hidden;
		background: #fff;
		transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
	}
	.event-card:hover {
		transform: translateY(-3px);
		border-color: var(--accent-dark);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.08);
	}
	.event-card.past {
		opacity: 0.92;
	}

	.event-card-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.event-card-media :global(img) {
		display: block;
		width: 100%;
		height: 200px;
		object-fit: cover;
	}

	.event-card-body {
		padding: 1.5em;
	}

	.event-card-kicker {
		margin: 0 0 0.4em;
		color: var(--accent-dark);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.past .event-card-kicker {
		color: rgb(var(--gray));
	}

	.event-card h3 {
		margin: 0 0 0.4em;
		font-size: 1.6rem;
		line-height: 1.1;
	}

	.event-card-meta {
		display: flex;
		flex-direction: column;
		gap: 0.15em;
		margin: 0 0 0.75em;
		font-size: 0.9rem;
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}

	.event-card-desc {
		margin: 0 0 1em;
		font-size: 1rem;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
	}

	.event-card-cta {
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--accent-dark);
	}
</style>
